# QQ 桥接配置（复制成 .env.qq 再改）
# 只有 QQ 通道读这个文件；微信通道用 .env，两者互不影响。

# ── 必填：谁能跟它说话 ─────────────────────────────────────────
# 你自己的 QQ 号。多个用逗号分隔。留空 = 谁的私聊都不回。
# 自用场景一般只填你自己。
QQ_ALLOW_LIST=

# ── 群聊（可选）───────────────────────────────────────────────
# 允许响应的群号，逗号分隔。留空 = 任何群都不响应（最安全）。
# 建议只放你自己建的群。
QQ_GROUP_ALLOW_LIST=

# 群里的触发词：消息以它开头才算叫它。（不带它就只是旁听，一个字节都不回）
QQ_GROUP_PREFIX=/ai

# ── NapCat 连接 ──────────────────────────────────────────────
# NapCat 里配置的「正向 WebSocket」。必须是本机回环地址。
QQ_WS_URL=ws://127.0.0.1:3001
# 和 NapCat 网络配置里的 token 保持一致（本机可以不设，设了更稳）
QQ_WS_TOKEN=
# NapCat 登录的 QQ 号。填上后会校验，防止不小心拿主号跑了
QQ_SELF_ID=

# ── 试运行 ───────────────────────────────────────────────────
# 1 = 完整跑流程（含模型调用）但不真的发 QQ 消息，只写日志/审计。
# 强烈建议第一次先设 1，观察一两天再改成 0。
QQ_DRY_RUN=1

# 1 = 配置向导：只把收到的 QQ 号/群号打印到日志（带 SETUP_DETECTED= 标记），
#     谁都不回复、不调模型。第一次不知道自己的 QQ 号/群号时开这个。
#     拿到号填进上面的白名单后，记得改回 0。
QQ_SETUP_MODE=1

# ── 限流（默认就是保守档，不建议放宽）────────────────────────
QQ_RATE_PER_GROUP_MIN=5      # 每个群每分钟最多触发几次
QQ_RATE_PER_USER_HOUR=20     # 每个人每小时最多触发几次
QQ_RATE_GLOBAL_MIN=12        # 全局每分钟最多触发几次
QQ_RATE_OUT_MIN=15           # 出站每分钟最多发几条（长回复分段也算）
QQ_REPLY_DELAY_MIN_MS=600    # 每条回复前的最小延迟
QQ_REPLY_DELAY_MAX_MS=2500   # 最大延迟（随机区间，伪装打字时间）
QQ_SEND_FAIL_BREAKER=5       # 连续发送失败几次就熔断停发
QQ_MAX_RECONNECT=12          # 连续重连失败几次就放弃并退出

# 聊天形态（人类感）
QQ_BUBBLE_MAX_CHARS=90   # 每条短消息的大致字数
QQ_BUBBLE_MAX=3          # 一次最多发几条
QQ_CHAT_THINK_MIN_MS=800 # 回消息前「看到+打字」的停顿
QQ_CHAT_THINK_MAX_MS=3000
QQ_DISTRACTED_CHANCE=0.03
# 打字速度：每字多少毫秒，以及封顶（别让人等两遍）
QQ_TYPING_MS_PER_CHAR=12
QQ_THINK_CAP_MS=1800
QQ_DISTRACTED_MIN_MS=3000
QQ_DISTRACTED_MAX_MS=8000
# 模型本身超过这个时长，就抵扣掉拟人等待（真人不会让你等两遍）
QQ_TURN_GRACE_MS=2500 # 偶尔走神晚点回的概率

# ── DSH ──────────────────────────────────────────────────────
AGENT_PROFILE=headless
# agent 执行命令时的工作目录（建议指向你的项目，不要用 $HOME）
AGENT_CWD=$HOME/Documents/deepseek
AGENT_TIMEOUT_MS=180000

# ── 回复行为 ─────────────────────────────────────────────────
MAX_REPLY_CHARS=1200         # 单条上限，超出自动分段（QQ 短一点更自然）
MAX_INPUT_CHARS=6000         # 单条输入上限
HISTORY_TURNS=8              # 带几轮历史
HISTORY_MAX_CHARS=6000
MAX_RUNS_GLOBAL=2            # 同时跑几个 dsh
QQ_REPLY_ACK=0               # 是否先回「收到，正在处理」（多一条出站消息）
ACK_DELAY_MS=12000

# ── 人设与看图 ───────────────────────────────────────────────
PERSONA_FILE=persona.md
VISION_ENABLED=1
# VISION_CLI=                # 留空自动探测 modlens
MAX_MEDIA_BYTES=26214400     # 单张图片上限

# ── 其他 ─────────────────────────────────────────────────────
DATA_DIR=data
QQ_AUDIT_FILE=               # 留空 = data/qq/audit.jsonl
LOG_LEVEL=info
# ── 生活状态：她自己的抖音号 ──
# 登录方法：npm run douyin:login（开窗口扫码，登录态存 data/douyin-profile/）
QQ_LIFE_ENABLED=0
QQ_LIFE_TICK_MS=1800000
QQ_LIFE_BROWSE_MAX_PER_DAY=3
QQ_LIFE_BROWSE_MIN_GAP_MIN=120
QQ_LIFE_BROWSE_CHANCE=0.3
QQ_LIFE_BROWSE_SCROLL=6
QQ_LIFE_BROWSE_TIMEOUT_MS=180000
# 点赞：只点她自己刷到的，每天上限
QQ_DOUYIN_LIKE_PER_BROWSE=1
QQ_DOUYIN_LIKE_MAX_PER_DAY=3

# ── 她自己的时间：没人说话时自己想一想、记一记（可选，默认关）──
# 想法落 data/mind/stream.jsonl；常驻进程：npm run mind（或 ./scripts/qqbridge-ctl.sh start）
QQ_MIND_ENABLED=0
QQ_MIND_MAX_PER_DAY=48
QQ_MIND_MIN_GAP_MIN=6
QQ_MIND_DREAM_MAX_PER_NIGHT=5
