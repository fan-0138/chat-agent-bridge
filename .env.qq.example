# ───────────────────────── QQ 通道（OneBot 11） ─────────────────────────
# 先让 OneBot 端（NapCat / LLOneBot / SnowLuma…）跑起来，再填这里。
QQ_WS_URL=ws://127.0.0.1:3001
QQ_WS_TOKEN=

# 只理这些人（QQ 号，逗号分隔）。第一次启动会打印你自己的号，填进来再重启。
QQ_ALLOW_LIST=123456789

# 群聊：要显式列出来她才说话，而且必须 @ 她 或带前缀；留空 = 所有群都闭嘴
QQ_GROUP_ALLOW_LIST=
QQ_GROUP_PREFIX=/ai

# ───────────────────────── 模型后端 ─────────────────────────
# dsh    = DeepSeek Harness 的 headless CLI（完整 agent：跑命令 / 读写文件 / 看图）
# openai = 任意 OpenAI 兼容接口（只会聊天，没有工具能力）
AGENT_BACKEND=dsh

# dsh 后端
# AGENT_CLI 不填时会自动找打包的 DeepSeek Harness.app，找不到再用 PATH 里的 dsh
AGENT_CLI=
DEEPSEEK_API_KEY=
AGENT_PROFILE=headless

# openai 后端
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
OPENAI_API_KEY=

# agent 工作目录 + 权限档位：workspace-write（只在自己的目录里动手）/ danger-full-access（能操作整台电脑）
AGENT_CWD=/Users/you/Documents
AGENT_PERMISSION_MODE=workspace-write

# ───────────────────────── 她是谁 ─────────────────────────
PERSONA_FILE=persona.md
AGENT_NAME=小鲸

# ───────────────────────── 上下文 / 长度 ─────────────────────────
HISTORY_TURNS=8
HISTORY_MAX_CHARS=6000
MAX_REPLY_CHARS=300
MAX_INPUT_CHARS=600
MAX_RUNS_GLOBAL=2

# ───────────────────────── 节奏与限流（防风控，别乱调大） ─────────────────────────
QQ_RATE_PER_USER_HOUR=60
QQ_RATE_GLOBAL_MIN=12
QQ_RATE_PER_GROUP_MIN=5
QQ_RATE_OUT_MIN=15
QQ_REPLY_DELAY_MIN_MS=250
QQ_REPLY_DELAY_MAX_MS=900
QQ_CHAT_THINK_MIN_MS=400
QQ_CHAT_THINK_MAX_MS=1200
QQ_DISTRACTED_CHANCE=0.03
QQ_BUBBLE_MAX_CHARS=90
QQ_BUBBLE_MAX=3
QQ_EMOJI_MAX=2
QQ_MAX_RECONNECT=12

AGENT_TIMEOUT_MS=300000
AGENT_CHAT_TIMEOUT_MS=60000

# 收到消息先应一句（只在真的要动手时）
QQ_REPLY_ACK=1
ACK_DELAY_MS=8000

# ───────────────────────── 可选能力 ─────────────────────────
# 语音（需要 .venv-tts 里的 edge-tts + 系统 ffmpeg，见 README）
QQ_VOICE_OUT=1
QQ_VOICE_NAME=zh-CN-XiaoyiNeural
QQ_VOICE_PITCH=+0Hz
QQ_VOICE_RATE=+5%
QQ_VOICE_MAX_PER_DAY=8
QQ_VOICE_MIN_GAP_MIN=8

# 表情包（丢进 data/stickers/ 就生效）
QQ_STICKER_CHANCE=0.28
QQ_STICKER_DIR=data/stickers

# 抖音网页版（私信 / 评论 / @）：先 node scripts/douyin-login.mjs 扫码登录
QQ_DOUYIN_CHAT_ENABLED=0
QQ_DOUYIN_RECHECK_SEC=25
QQ_DOUYIN_NOTICE=1

# 主动找人 / 生活状态（会自己刷抖音、自己找话说）
QQ_PROACTIVE_ENABLED=1
QQ_PROACTIVE_MAX_PER_DAY=12
QQ_PROACTIVE_MIN_GAP_MIN=20
QQ_PROACTIVE_AFTER_IDLE_MIN=15
QQ_PROACTIVE_CHANCE=0.35
QQ_PROACTIVE_QUIET_START=2
QQ_PROACTIVE_QUIET_END=8
QQ_LIFE_ENABLED=1

# 关掉前先喊一声（在线够久才喊，防止反复重启刷屏）
QQ_FAREWELL_MIN_UPTIME_MIN=30

LOG_LEVEL=info