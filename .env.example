# ───────────────────────── 微信通道（腾讯 iLink 机器人） ─────────────────────────
# 第一次启动会打印二维码，用微信扫一下即可绑定；之后复用登录态。
WECHAT_ALLOW_LIST=wxid_or_openid_placeholder
WECHAT_ALLOW_UNKNOWN=0

# ───────────────────────── 模型后端 ─────────────────────────
AGENT_BACKEND=dsh
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
OPENAI_API_KEY=

AGENT_CWD=/Users/you/Documents
AGENT_PERMISSION_MODE=workspace-write

# ───────────────────────── 她是谁 ─────────────────────────
PERSONA_FILE=persona.md
AGENT_NAME=小鲸

# ───────────────────────── 节奏 ─────────────────────────
HISTORY_TURNS=8
HISTORY_MAX_CHARS=6000
MAX_REPLY_CHARS=300
REPLY_ACK=1
ACK_DELAY_MS=15000
LOG_LEVEL=info
DATA_DIR=data